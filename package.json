{
  "name": "ingresos-api",
  "version": "1.0.0",
  "private": true,
  "description": "API de ingressos com FIFO, PostgreSQL e limites atômicos.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "node --import tsx src/server.ts",
    "local": "npm run build && node scripts/local.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts",
    "load": "node scripts/load-test.mjs"
  },
  "dependencies": {
    "@fastify/jwt": "10.2.7",
    "fastify": "5.12.8",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "embedded-postgres": "18.6.0-beta.19",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
